# Database -- SQLite by default (zero setup). For production, point this at
# PostgreSQL instead, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/smart_city
DATABASE_URL=sqlite:///./smart_city.db

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# Google Maps Platform (needs a billing-enabled Google Cloud project).
# Leave blank to use the free OpenStreetMap Nominatim geocoder instead --
# the app works either way, this just controls which provider answers
# /api/location/search and /api/location/details.
GOOGLE_MAPS_API_KEY=

# Only used as the fallback geocoder's User-Agent when GOOGLE_MAPS_API_KEY
# is blank -- Nominatim's usage policy asks for a real contact email here.
GEOCODE_USER_AGENT=DebanjansCreationSmartCity/1.0 (your-email@example.com)

# Optional real weather provider (https://openweathermap.org/api). Leave
# blank and /api/weather returns clearly-labeled simulation data instead.
OPENWEATHER_API_KEY=

CORS_ORIGINS=*
